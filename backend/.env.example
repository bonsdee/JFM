# ---- Spring profile: dev loads sample data, prod does not ----
SPRING_PROFILES_ACTIVE=dev

# ---- Supabase Postgres (use the connection POOLER string from Project Settings → Database) ----
# Session pooler (port 5432) recommended for Spring/Hikari. Transaction pooler (6543) also works (prepareThreshold=0 is set).
DB_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=your-database-password

# ---- Supabase Auth / Storage ----
SUPABASE_URL=https://your-project-ref.supabase.co
# New projects (asymmetric signing keys): leave SUPABASE_JWT_SECRET empty; JWKS is derived from SUPABASE_URL.
SUPABASE_JWKS_URL=
# Legacy projects (HS256 shared secret): Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=
# Server-side only! Used to sign Storage upload/download URLs.
SUPABASE_SERVICE_ROLE_KEY=

# ---- The single owner (Authentication → Users → copy the user's UID) ----
APP_OWNER_ID=00000000-0000-0000-0000-000000000000
APP_OWNER_EMAIL=owner@example.com

# ---- CORS (comma separated) ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-site.vercel.app
