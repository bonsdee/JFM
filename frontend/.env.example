# Supabase project (Project Settings → API). The anon key is safe in the browser:
# RLS is enabled on every table with no policies, so it can only be used for Auth + signed Storage uploads.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Spring Boot API (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080

# Password-only login: the owner's email (same as APP_OWNER_EMAIL in backend/.env).
# When set, the login screen asks only for the password. Leave empty to show the email field.
VITE_OWNER_EMAIL=
